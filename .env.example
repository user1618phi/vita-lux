# Copy to .env.local and fill in. Never commit .env.local — .gitignore already
# excludes it. Nothing here has a safe default in production.
#
# ВАЖНО: это монорепо, и Next читает .env из каталога того приложения, которое
# запускается. Одного файла в корне НЕ хватит — нужны копии там, где они реально
# нужны:
#   apps/web/.env.local     — CATALOG_SOURCE, DATABASE_URL, NEXT_PUBLIC_*,
#                             APP_ENCRYPTION_KEY, APP_HASH_SALT, TELEGRAM_*
#   apps/admin/.env.local   — ADMIN_ENABLED, DATABASE_URL, APP_*, STORAGE_*, SUPABASE_*
#   .env.local (корень)     — для скриптов: db:seed, db:parity, db:admin
# ADMIN_ENABLED осмыслен ТОЛЬКО для apps/admin: витрина админку не обслуживает.

# ── Admin panel ─────────────────────────────────────────────────────────────
# Whether this deployment serves /admin at all. Set to exactly "1" to enable.
# Anything else — including leaving it unset — makes every /admin request 404,
# server actions included. Deliberately fail-closed: a demo or preview deploy
# that forgets this variable ships the storefront with no back office exposed.
# Leave it EMPTY on any public demo.
ADMIN_ENABLED=1

# ── Catalog source ──────────────────────────────────────────────────────────
# "mock" (default) serves the hardcoded catalog and needs no database, so
# `pnpm dev` and CI work with none of the variables below. Switch to "db" once
# the schema is migrated and seeded.
CATALOG_SOURCE=mock

# ── Database ────────────────────────────────────────────────────────────────
# Postgres connection string (Supabase / Neon / self-hosted). Required by
# CATALOG_SOURCE=db, the admin panel and order placement.
# Behind a transaction pooler, keep ?pgbouncer=true and the driver's prepare:false.
DATABASE_URL=

# ── Secrets ─────────────────────────────────────────────────────────────────
# Encrypts customer name / phone / address at rest. Exactly 32 bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes existing encrypted orders unreadable — keep a backup.
APP_ENCRYPTION_KEY=

# Salts the lookup hashes (phone de-duplication, session tokens). Any long
# random string. Changing it invalidates every active admin session.
APP_HASH_SALT=

# ── Photo storage ───────────────────────────────────────────────────────────
# "local" (default) writes into public/uploads — development only, since the
# filesystem is read-only on Vercel. Use "supabase" in production.
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=product-media

# ── Order notifications ─────────────────────────────────────────────────────
# Telegram bot that announces new orders. Create the bot with @BotFather, add
# it to a group, and read the group id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
# Orders are still stored when these are empty — only the alert is skipped.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Public site & analytics ─────────────────────────────────────────────────
# The canonical origin. Until this is set, robots.txt disallows everything and
# pages carry noindex — placeholder prices must not reach the search index.
NEXT_PUBLIC_SITE_URL=

# GA4 measurement id (G-XXXXXXXXXX). Empty means no tag is loaded at all.
NEXT_PUBLIC_GA_ID=

# ── Storefront cache invalidation ───────────────────────────────────────────
# The admin and the storefront are separate Vercel projects, so the admin
# cannot reach the storefront's cache directly — it POSTs to /api/revalidate
# instead. Both sides need the SAME secret; when either is empty, publishing is
# silently skipped and changes lag by the 300 s TTL in packages/data.
REVALIDATE_SECRET=
# Storefront origin the admin calls, e.g. https://vitalux.kz
SITE_REVALIDATE_URL=
# Admin origin used in the Telegram order link, e.g. https://admin.vitalux.kz
ADMIN_ORDER_URL=

# ── X2pos (склад и касса) ───────────────────────────────────────────────────
# X2pos — учётная система владельца: остатки, цены и фото живут там, а сайт их
# только читает. Обратно уходят продажи, чтобы остаток списывался.
#
# Fail-closed, как ADMIN_ENABLED: интеграция работает ТОЛЬКО при значении "1".
# При любом другом значении сайт торгует по данным своей БД, а заказы копятся
# в очереди x2pos_outbox и уедут, когда переменную включат.
X2POS_ENABLED=0
X2POS_USER=
X2POS_PASSWORD=
# Идентификаторы конкретной компании в X2pos. Узнать: GET /api/employee,
# /api/company_settings, /api/pos, /api/finance_accounts.
X2POS_BRANCH_ID=
X2POS_KASSA_ID=
X2POS_USER_ID=
X2POS_EMPLOYEE_ID=
# Денежный счёт, на который оформляется возврат при отмене заказа.
X2POS_CASH_ACCOUNT_ID=
# Метка источника продажи — отличает интернет-заказы от кассовых в отчётах.
X2POS_CHANNEL=VITASHOP

# Секрет для крон-роутов /api/x2pos/* в админке. Роут-хендлеры не проходят
# через layout, а сессионная проверка живёт там — без этого секрета у них не
# было бы никакой авторизации. Принимается в заголовке x-vita-cron либо
# Authorization: Bearer (так ходит Vercel Cron).
CRON_SECRET=

# Адрес воркера синхронизации на Railway. Нужен админке, чтобы кнопки
# «Запустить сейчас» на экране «Обмен» могли дёрнуть задание, не дожидаясь
# расписания. Секрет тот же, что у крона, — CRON_SECRET выше.
X2POS_WORKER_URL=https://x2pos-worker-production.up.railway.app
