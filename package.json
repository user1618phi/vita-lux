{
  "name": "vita",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @vita/web dev",
    "dev:admin": "pnpm --filter @vita/admin dev",
    "build": "pnpm -r --if-present build",
    "start": "pnpm --filter @vita/web start",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit",
    "locales": "node scripts/check-kk-glyphs.mjs",
    "db:generate": "pnpm --filter @vita/db db:generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "pnpm --filter @vita/db db:studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:parity": "tsx scripts/parity.ts",
    "db:admin": "tsx scripts/create-admin.ts",
    "db:media": "tsx scripts/mirror-media.ts"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@vita/core": "workspace:*",
    "@vita/data": "workspace:*",
    "@vita/db": "workspace:*",
    "@vita/i18n": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@11.1.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "sharp"
    ]
  }
}
